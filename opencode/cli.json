{
  "$schema": "https://opencode.ai/v2/cli.json",
  "keybinds": {
    "model.list": "ctrl+m",
    "agent.cycle": "shift+tab"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true,
  "mini": {
    "tools": "show",
    "thinking": "show",
    "work_spinner": "block-low-comet",
    "mono": false,
    "splash": "hide",
    "shell_output": "show",
    "turn_summary": "show",
    "footer": "show"
  }
}
