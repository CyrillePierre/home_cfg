{
  "$schema": "https://opencode.ai/v2/cli.json",
  "keybinds": {
    "agent.cycle": "shift+tab"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide",
    "grouping": "none",
    "verbosity": "high"
  },
  "animations": true,
  "mini": {
    "tools": "show",
    "thinking": "show",
    "work_spinner": "block-low-comet",
    "mono": false,
    "splash": "hide",
    "shell_output": "show",
    "turn_summary": "show",
    "footer": "show"
  },
  "theme": {
    "name": "opencode"
  }
}