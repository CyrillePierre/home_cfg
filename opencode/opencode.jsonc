{
  "$schema": "https://opencode.ai/config.json",

  "plugins": [
  ],

  "provider": {
    "inrae-argo": {
      // "name": "INRAE ARGO",
      // "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://chatbot.argo.inrae.fr/api",
        "apiKey": "{file:~/.secrets/inrae_argo_api_key}",
        "websearch": "always"
      },
      "models": {
        "chat-gpt-oss-120b": {
          "name": "GPT OSS 120b",
          "limit": {
            "context": 128000,
            "output": 65536
          }
        },
        "assistant-inrae-expert": {
          "name": "Assistant INRAE large"
        },
        "chat-gpt-oss-20b": {
          "name": "GPT OSS 20b"
        },
        "assistant-inrae": {
          "name": "Assistant INRAE small"
        }
      }
    }
  },

  "model": "inrae-argo/chat-gpt-oss-120b",

  "permission": {
    "nextcloud_nc_share_create_public_link": "ask",
    "webfetch": "ask",
    "websearch": "ask"
  },

  "mcp": {
    "thunderbird": {
      "enabled": false,
      "type": "remote",
      "url": "http://localhost:8765",
      "headers": {
        "Authorization": "Bearer {file:~/.secrets/thunderbird_api_key}"
      }
    },

    "nextcloud-inrae": {
      "enabled": false,
      "type": "local",
      "command": ["uvx", "nextcloud-mcp-server", "run", "--transport", "stdio"],
      "environment": {
        "NEXTCLOUD_HOST": "https://nextcloud.inrae.fr",
        "NEXTCLOUD_USERNAME": "{file:~/.secrets/inrae_nextcloud_mcp_username}",
        "NEXTCLOUD_PASSWORD": "{file:~/.secrets/inrae_nextcloud_mcp_password}"
      }
    },

    // web search
    "donsetch": {
      "enabled": true,
      "type": "local",
      "command": ["npx", "donsetch", "mcp"]
    }
  },

  "tools": {
    "thunderbird": false,
    "nextcloud-inrae": false,
    "donsetch": true
  },

  "agents": {
    "search": {
      "name": "search",
      "description": "Agent for searching Nextcloud files and Thunderbird emails",
      "tools": {
        "thunderbird": true,
        "nextcloud-inrae": true
      }
    }
  }
}
