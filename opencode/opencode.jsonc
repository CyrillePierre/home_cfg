{
  "$schema": "https://opencode.ai/config.json",

  "plugins": [
  ],

  "providers": {
    "inrae-argo": {
      // "name": "INRAE ARGO",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "https://chatbot.argo.inrae.fr/api",
        "apiKey": "{file:~/.secrets/inrae_argo_api_key}"
      },
      "models": {
        "chat-gpt-oss-120b": {
          "name": "GPT OSS 120b",
          "limit": {
            "context": 131072
          }
        },
        "assistant-inrae-expert": {
          "name": "Assistant INRAE large",
          "limit": {
            "context": 131072
          }
        },
        "chat-gpt-oss-20b": {
          "name": "GPT OSS 20b",
          "limit": {
            "context": 20480
          }
        },
        "assistant-inrae": {
          "name": "Assistant INRAE small",
          "limit": {
            "context": 20480
          }
        }
      }
    },

    "opencode": {
      "models": {
        "glm-5.3-flash-free": {
          "name": "GLM 5.3 Flash Free",
          "limit": {
            "context": 200000,
            "output": 32000
          }
        },
        "deepseek-v4.1-flash-free": {
          "name": "DeepSeek V4.1 Flash Free",
          "limit": {
            "context": 200000,
            "output": 32000
          }
        }
      }
    },

    "agrotwin": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "Agrotwin",
      "settings": {
        "baseURL": "https://23-1471a25092-f.local:8443/v1",
        // "baseURL": "http://23-1471a25092-f.local:8080/v1",
        "apiKey": "{file:~/.secrets/agrotwin_strat_api_key}"
      },
      "models": {
        "qwen3.8-flash-next-iq3_s": {
          "name": "Qwen3.8-Flash-Next iQ3",
          "type": "chat",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": true,
              "effort": [
                "low",
                "medium",
                "high"
              ],
              "toggle": true
            }
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "variants": [
            {
              "id": "low",
              "settings": {
                "reasoningEffort": "low"
              },
              "body": {
                "reasoning_budget_tokens": 2048
              }
            },
            {
              "id": "none",
              "body": {
                "reasoning_effort": "none"
              }
            },
            {
              "id": "budget",
              "body": {
                "reasoning_budget_tokens": 4096
              }
            }
          ],
          "limit": {
            "context": 262144,
            "input": 258048,
            "output": 32768
          }
        }
      }
    }
  },

  "model": "inrae-argo/chat-gpt-oss-120b",

  "permissions": [
    // MCP tools are off unless an agent allows them (see agents.search).
    { "action": "thunderbird_*", "resource": "*", "effect": "deny" },
    { "action": "nextcloud-inrae_*", "resource": "*", "effect": "deny" },
    { "action": "donsetch_*", "resource": "*", "effect": "allow" },

    { "action": "nextcloud_nc_share_create_public_link", "resource": "*", "effect": "ask" },
    { "action": "webfetch", "resource": "*", "effect": "ask" },
    { "action": "websearch", "resource": "*", "effect": "ask" },

    // V1 asked before touching paths outside the project; V2 allows them by default.
    { "action": "external_directory", "resource": "*", "effect": "ask" }
  ],

  "mcp": {
    "servers": {
      "thunderbird": {
        "type": "remote",
        "url": "http://localhost:8765",
        "headers": {
          "Authorization": "Bearer {file:~/.secrets/thunderbird_api_key}"
        },
        "disabled": true
      },

      "nextcloud-inrae": {
        "type": "local",
        "command": ["uvx", "nextcloud-mcp-server", "run", "--transport", "stdio"],
        "environment": {
          "NEXTCLOUD_HOST": "https://nextcloud.inrae.fr",
          "NEXTCLOUD_USERNAME": "{file:~/.secrets/inrae_nextcloud_mcp_username}",
          "NEXTCLOUD_PASSWORD": "{file:~/.secrets/inrae_nextcloud_mcp_password}"
        },
        "disabled": true
      },

      // web search
      "donsetch": {
        "type": "local",
        "command": ["npx", "donsetch", "mcp"],
        "environment": {
          "DONSETCH_NO_UPDATE_CHECK": "1"
        },
        "disabled": false
      }
    }
  },

  "agents": {
    "search": {
      "description": "Agent for searching Nextcloud files and Thunderbird emails",
      "mode": "subagent",
      "model": "inrae-argo/chat-gpt-oss-120b",
      "permissions": [
        { "action": "thunderbird_*", "resource": "*", "effect": "allow" },
        { "action": "nextcloud-inrae_*", "resource": "*", "effect": "allow" }
      ]
    }
  }
}
